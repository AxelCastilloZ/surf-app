{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    {
      "source": "/:path+",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Googlebot-Image|AdsBot-Google|googleweblight|Storebot-Google|Google-InspectionTool|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|Embedly|bingbot|Baiduspider|YandexBot).*" }],
      "destination": "/api/prerender?path=/:path+"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
